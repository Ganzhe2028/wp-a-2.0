# Neon PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# HMAC secret shared only with the external image scan/re-encode worker.
ASSET_PROCESSOR_SECRET=
ASSET_PROCESSOR_URL=

# Authentication
# LOCAL_ONLY | HYBRID | OIDC_ONLY. The app remains fully usable with local.
AUTH_MODE=LOCAL_ONLY
# Required; generate with: openssl rand -base64 48.
SESSION_SECRET=
# Required for deterministic per-event Anonymous IDs.
ANON_HMAC_SECRET=
# Optional until the school provides OIDC. Required in hybrid/oidc mode.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Legacy migration only. The formal Admin account uses accountCode + password
# and role=ADMIN; do not use this for new deployments.
ADMIN_PASSWORD=
ALLOW_LEGACY_ADMIN_PASSWORD=false
ALLOW_LEGACY_STUDENT_PASSWORD=false

# Application
APP_BASE_URL=http://localhost:3000
APP_ENV=local
EVENT_TIMEZONE=Asia/Shanghai
OWEEK_EVENT_KEY=oweek-2026
OWEEK_EVENT_NAME=O-Week 2026
MAX_UPLOAD_BYTES=524288
# Required by the authenticated Vercel maintenance cron.
CRON_SECRET=
