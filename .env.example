# Neon PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# HMAC secret shared only with the external image scan/re-encode worker.
ASSET_PROCESSOR_SECRET=
ASSET_PROCESSOR_URL=

# Authentication
# LOCAL_ONLY | HYBRID | OIDC_ONLY. The app remains fully usable with local.
AUTH_MODE=LOCAL_ONLY
# Required; generate with: openssl rand -base64 48.
SESSION_SECRET=
# Required for deterministic per-event Anonymous IDs.
ANON_HMAC_SECRET=
# Required for the first protected Admin bootstrap or security rotation only.
# Use a unique 16-128 character secret; remove it after successful provisioning.
PROTECTED_ADMIN_INITIAL_PASSWORD=
# P1 后续能力：本次发布保持为空，只有改为 HYBRID 或 OIDC_ONLY 时才需要配置。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 旧系统仅保留数据备份，本次发布始终关闭旧入口。
ADMIN_PASSWORD=
ALLOW_LEGACY_ADMIN_PASSWORD=false
ALLOW_LEGACY_STUDENT_PASSWORD=false

# Application
# 本地示例。生产固定使用 https://msoweek.site（不使用 www）。
APP_BASE_URL=http://localhost:3000
APP_ENV=local
EVENT_TIMEZONE=Asia/Shanghai
OWEEK_EVENT_KEY=oweek-2026
OWEEK_EVENT_NAME=O-Week 2026
MAX_UPLOAD_BYTES=524288
# 仅本地开发：启用后由 /api/local-upload 模拟 R2 对象存储。
LOCAL_UPLOAD_DIR=
# Required by the authenticated Vercel maintenance cron.
CRON_SECRET=
