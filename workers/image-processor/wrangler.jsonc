{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oweek-image-processor",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_BASE_URL": "https://www.msoweek.site",
    "PUBLIC_ORIGIN": "https://www.msoweek.site",
    "R2_BUCKET_NAME": "oweek-images",
    "MAX_IMAGE_BYTES": "524288"
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "oweek-images"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
