{
  "openapi": "3.1.0",
  "info": {
    "title": "O-Week v1.1 API",
    "version": "1.1.0",
    "description": "Formal User-based API. Authentication uses the HttpOnly owk_session cookie."
  },
  "servers": [{ "url": "/api/v1" }],
  "tags": [
    { "name": "Auth" }, { "name": "Student" }, { "name": "Assets" },
    { "name": "Gallery" }, { "name": "Admin" }
  ],
  "paths": {
    "/auth/methods": { "get": { "tags": ["Auth"], "operationId": "getAuthMethods", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/login": { "post": { "tags": ["Auth"], "operationId": "loginLocal", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalLogin" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/auth/logout": { "post": { "tags": ["Auth"], "operationId": "logout", "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/auth/session": { "get": { "tags": ["Auth"], "operationId": "getSession", "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/oidc/start": { "get": { "tags": ["Auth"], "operationId": "startOidc", "parameters": [{ "$ref": "#/components/parameters/ReturnTo" }], "responses": { "307": { "description": "Redirect to the configured OIDC authorization endpoint" } } } },
    "/auth/oidc/callback": { "get": { "tags": ["Auth"], "operationId": "oidcCallback", "parameters": [{ "name": "code", "in": "query", "schema": { "type": "string" } }, { "name": "state", "in": "query", "schema": { "type": "string" } }], "responses": { "307": { "description": "Create the server session and redirect to the safe return path, or redirect to login with an error" } } } },
    "/home": { "get": { "tags": ["Student"], "operationId": "getHome", "security": [{ "sessionCookie": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/submissions/{section}": { "get": { "tags": ["Student"], "operationId": "getSubmission", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/Section" }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/submissions/{section}/draft": { "put": { "tags": ["Student"], "operationId": "saveDraft", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/Section" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftWrite" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/submissions/{section}/submit": { "post": { "tags": ["Student"], "operationId": "submitSection", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/Section" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Submit" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/assets/presign": { "post": { "tags": ["Assets"], "operationId": "presignAsset", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssetPresign" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/assets/{assetId}": { "get": { "tags": ["Assets"], "operationId": "getAssetProcessingStatus", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/AssetId" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/assets/{assetId}/complete": { "post": { "tags": ["Assets"], "operationId": "completeAsset", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/AssetId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "202": { "$ref": "#/components/responses/Success" }, "422": { "$ref": "#/components/responses/Error" } } } },
    "/gallery": { "get": { "tags": ["Gallery"], "operationId": "getGallery", "security": [{ "sessionCookie": [] }], "description": "Returns every eligible active account page in the requested division by default. Submission state controls content availability, not page existence. Counselor-owned pages are included in the existing SENIOR division, while Counselor viewers have the same unrestricted browse scope as Learners. Senior viewers are limited to Learners in their own Group unless the audited seniorCanBrowseAll setting is enabled. Set filled=true to include only accounts with a submitted section.", "parameters": [{ "name": "section", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Section" } }, { "name": "division", "in": "query", "required": true, "schema": { "enum": ["SENIOR", "LEARNER"] } }, { "name": "filled", "in": "query", "schema": { "type": "boolean", "default": false } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "query", "in": "query", "schema": { "type": "string", "maxLength": 80 } }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/artworks/{publicId}": { "get": { "tags": ["Gallery"], "operationId": "getArtwork", "description": "Day 1 slots include the current template description for the same slotKey used by the editor. Day 3 bottle results include their theme group and theme subtitle so the presentation preserves the answering context.", "security": [{ "sessionCookie": [] }], "parameters": [{ "name": "publicId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/admin/login": { "post": { "tags": ["Admin"], "operationId": "loginAdminLocal", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LocalLogin" } } } }, "responses": { "200": { "$ref": "#/components/responses/Success" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/admin/logout": { "post": { "tags": ["Admin"], "operationId": "logoutAdmin", "security": [{ "sessionCookie": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/session": { "get": { "tags": ["Admin"], "operationId": "getAdminSession", "security": [{ "sessionCookie": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/admin/dashboard": { "get": { "tags": ["Admin"], "operationId": "getAdminDashboard", "security": [{ "sessionCookie": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/settings": { "get": { "tags": ["Admin"], "operationId": "getAdminSettings", "security": [{ "sessionCookie": [] }], "responses": { "200": { "$ref": "#/components/responses/Success" } } }, "patch": { "tags": ["Admin"], "operationId": "updateAdminSettings", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/settings/apply-preset": { "post": { "tags": ["Admin"], "operationId": "applyAdminPreset", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts": { "get": { "tags": ["Admin"], "operationId": "listAdminAccounts", "security": [{ "sessionCookie": [] }], "description": "Lists accounts with ACTIVE accounts before ARCHIVED accounts by default. Set status=ACTIVE to hide archived accounts from the result.", "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] } }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } },
    "/admin/groups": { "post": { "tags": ["Admin"], "operationId": "createAdminGroup", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/groups/{id}": { "patch": { "tags": ["Admin"], "operationId": "renameAdminGroup", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/GroupId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } }, "delete": { "tags": ["Admin"], "operationId": "deleteAdminGroup", "description": "Unassigns every member before deleting the group. Senior accounts become fail-closed until assigned to another group.", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/GroupId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts/import": { "post": { "tags": ["Admin"], "operationId": "importAdminAccounts", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts/import-emails": { "post": { "tags": ["Admin"], "operationId": "importAdminAccountEmails", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts/export-exhibition": { "post": { "tags": ["Admin"], "operationId": "exportSelectedAdminExhibitionLinks", "description": "Exports only the selected ACTIVE accounts and their canonical /artworks/{publicId} exhibition URLs for programming NFC tags. Archived or missing selections fail as a whole.", "security": [{ "sessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["accountIds"], "properties": { "accountIds": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "type": "string" } } } } } } }, "responses": { "200": { "description": "UTF-8 CSV with displayName, accountCode, role, groupName and exhibitionUrl", "content": { "text/csv": { "schema": { "type": "string" } } } }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts/bulk": { "post": { "tags": ["Admin"], "operationId": "bulkUpdateAdminAccounts", "description": "Runs confirmed account batch operations. PURGE_ARCHIVED permanently removes only selected ARCHIVED, non-protected accounts and their associated works; ACTIVE accounts are rejected.", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts/{id}": { "patch": { "tags": ["Admin"], "operationId": "updateAdminAccount", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/accounts/{id}/reset-password": { "post": { "tags": ["Admin"], "operationId": "resetAdminAccountPassword", "security": [{ "sessionCookie": [] }], "parameters": [{ "$ref": "#/components/parameters/UserId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "$ref": "#/components/responses/Success" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/admin/audit-logs": { "get": { "tags": ["Admin"], "operationId": "listAdminAuditLogs", "security": [{ "sessionCookie": [] }], "parameters": [{ "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } }, { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } }], "responses": { "200": { "$ref": "#/components/responses/Success" } } } }
  },
  "components": {
    "securitySchemes": { "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "owk_session" } },
    "parameters": {
      "ReturnTo": { "name": "returnTo", "in": "query", "schema": { "type": "string", "pattern": "^/(?!/)" } },
      "Section": { "name": "section", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Section" } },
      "AssetId": { "name": "assetId", "in": "path", "required": true, "schema": { "type": "string" } },
      "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "GroupId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "schemas": {
      "Section": { "type": "string", "enum": ["day1", "day3"] },
      "LocalLogin": { "type": "object", "additionalProperties": false, "required": ["accountCode", "password"], "properties": { "accountCode": { "type": "string" }, "password": { "type": "string" }, "returnTo": { "type": "string" } } },
      "DraftWrite": { "type": "object", "required": ["version", "templateVersion"], "properties": { "version": { "type": "integer", "minimum": 1 }, "templateVersion": { "type": "string" }, "slots": { "type": "array", "items": { "type": "object" } }, "bottles": { "type": "array", "items": { "type": "object" } } } },
      "Submit": { "type": "object", "additionalProperties": false, "required": ["version", "confirm"], "properties": { "version": { "type": "integer", "minimum": 1 }, "confirm": { "const": true } } },
      "AssetPresign": { "type": "object", "additionalProperties": false, "required": ["section", "mimeType", "byteSize", "checksum"], "properties": { "section": { "const": "DAY1" }, "mimeType": { "enum": ["image/jpeg", "image/png", "image/webp"] }, "byteSize": { "type": "integer", "minimum": 1 }, "checksum": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } } },
      "ErrorEnvelope": { "type": "object", "required": ["error", "requestId"], "properties": { "error": { "type": "object", "required": ["code", "message", "details"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "object" } } }, "requestId": { "type": "string", "pattern": "^req_" } } },
      "SuccessEnvelope": { "type": "object", "required": ["data", "requestId"], "properties": { "data": {}, "requestId": { "type": "string", "pattern": "^req_" } } }
    },
    "responses": {
      "Success": { "description": "Successful response", "headers": { "Cache-Control": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SuccessEnvelope" } } } },
      "Error": { "description": "Stable error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    }
  }
}
